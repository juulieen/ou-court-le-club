# Configuration du notifieur RunEvent86 — copier en .env et remplir.
# En CI, ce fichier est généré depuis les secrets GitHub (deploy-notify.yml).

# URL de l'API Beeper Desktop (machine joignable via Tailscale)
BEEPER_API=http://<IP-TAILSCALE>:23373

# Conversation cible des notifs (ID Matrix Beeper).
# "Note to self" tant que le passage en prod n'est pas validé.
BEEPER_CHAT_ID=<id-chat-note-to-self>

# Conversation pour les rappels d'expiration du token (perso, jamais le groupe)
BEEPER_REMINDER_CHAT_ID=<id-chat-note-to-self>

# "" = dry-run (log sans envoyer) ; "--live" = envoi réel
NOTIFY_ARGS=
